# Copy to .env (git-ignored) and fill in. Never commit .env, never paste keys into chat.
OPENROUTER_API_KEY=
# A small, fast, cheap model id from https://openrouter.ai/models (record the one you pick and the date in the AI log)
OPENROUTER_MODEL=
# Use the port your container is on (see README: DB_PORT)
DATABASE_URL=postgresql://sahyog:sahyog_local_only@localhost:55432/sahyog
# Demo only, never production.
SAHYOG_DEMO_AUTH=1
# Comma-separated MCP X-Agent-Id allowlist. Demo values only; not an identity provider.
MCP_APPROVED_AGENTS=agent-demo,agent-staff-demo
# Optional MCP DNS-rebinding allowlists; configure the public API host/origin for deployment.
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000,127.0.0.1:8001,localhost:8001
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001
# Optional: let OpenRouter pick the fastest provider (latency | throughput | price)
OPENROUTER_PROVIDER_SORT=latency
# Optional alternate OpenRouter model ids; when unset, the hedge uses this model with provider fallbacks enabled.
OPENROUTER_FALLBACK_MODEL_W1=
OPENROUTER_FALLBACK_MODEL_W2=
# Check each chosen model's provider list on its OpenRouter model page before setting these.
# The first listed provider is pinned for the primary; the hedge excludes it.
OPENROUTER_PROVIDERS_W1=deepinfra,together,fireworks
OPENROUTER_PROVIDERS_W2=deepinfra,together,fireworks
# Maximum total time per model call; defaults are 8 s for W1 and 6 s for W2.
LLM_DEADLINE_S_W1=8
LLM_DEADLINE_S_W2=6
# Start one provider-distinct hedged request; defaults are 2 s for W1 and 3 s for W2.
LLM_HEDGE_AFTER_S_W1=2
LLM_HEDGE_AFTER_S_W2=3
# W1's model-outage front-desk message uses this call-back window.
W1_FRONT_DESK_SLA_MINUTES=30
OPS_REVIEW_SLA_MINUTES=30
RL_READ_PER_MIN=30
RL_BOOK_PER_HOUR=20
# Optional model pricing for tools/build_cost_sheet.py and /ops; price per million tokens.
PRICE_IN_PER_MTOK_W1=
PRICE_OUT_PER_MTOK_W1=
PRICE_IN_PER_MTOK_W2=
PRICE_OUT_PER_MTOK_W2=
PRICE_DATE=
