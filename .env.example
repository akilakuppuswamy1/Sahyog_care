# Copy to .env (git-ignored) and fill in. Never commit .env, never paste keys into chat.
OPENROUTER_API_KEY=
# A small, fast, cheap model id from https://openrouter.ai/models (record the one you pick and the date in the AI log)
OPENROUTER_MODEL=
# Use the port your container is on (see README: DB_PORT)
DATABASE_URL=postgresql://sahyog:sahyog_local_only@localhost:55432/sahyog
# Optional: let OpenRouter pick the fastest provider (latency | throughput | price)
OPENROUTER_PROVIDER_SORT=latency
# Optional alternate OpenRouter model ids; when unset, the hedge uses this model with provider fallbacks enabled.
OPENROUTER_FALLBACK_MODEL_W1=
OPENROUTER_FALLBACK_MODEL_W2=
# Maximum total time per model call; defaults are 3.5 s for W1 and 6 s for W2.
LLM_DEADLINE_S_W1=3.5
LLM_DEADLINE_S_W2=6
# Start one hedged request after this many seconds; defaults are 1.8 s for W1 and 3 s for W2.
LLM_HEDGE_AFTER_S=
# W1's model-outage front-desk message uses this call-back window.
W1_FRONT_DESK_SLA_MINUTES=30
RL_READ_PER_MIN=30
RL_BOOK_PER_HOUR=20
